# Supabase Database Connection (Transaction Pooler - Port 6543 for Netlify Serverless Functions)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"

# Supabase Session Pooler (Port 5432 - IPv4 compatible for Prisma Migrations & Schema Push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Authentication Secret Key (Used for Admin JWT token generation)
JWT_SECRET="your_custom_secure_jwt_secret_key"

# Environment
NODE_ENV="production"
